# ── LOCAL DEV ONLY ────────────────────────────────────────────────────────────
# These vars are used when running the pipeline or dashboard on your local machine.
# Do NOT set GHOSTVENDOR_LOCAL_DEV in GitHub Actions or Streamlit Cloud secrets.

# Set to "1" on your local machine only. Effects:
#   - Pipeline (repo_cloner.py): skips git clone, uses your local repo copy.
#   - Dashboard (db.py): uses SQLite (ghostvendor.db) instead of Supabase.
# GitHub Actions and Streamlit Cloud must NOT have this set — they use
# git clone (Actions) and Supabase (both).
GHOSTVENDOR_LOCAL_DEV=1

NEBIUS_API_KEY=your_nebius_token_factory_api_key
NEBIUS_PROJECT_ID=your_nebius_project_id
TAVILY_API_KEY=your_tavily_api_key

# GitHub PAT — needs repo + workflow scopes.
# Named GH_PAT in GitHub Actions secrets (GitHub blocks secrets starting with GITHUB_).
# Injected into the workflow as GITHUB_TOKEN via the env: block in run_pipeline.yml.
GITHUB_TOKEN=your_github_pat

# ── SHARED (GitHub Actions + Streamlit Cloud + local migration) ───────────────
# Supabase is the shared database between:
#   - GitHub Actions runner (pipeline writes events as it runs)
#   - Streamlit Cloud dashboard (reads events for live neural-network updates)
#
# Add SUPABASE_URL and SUPABASE_ANON_KEY to BOTH:
#   1. GitHub Actions → repo Settings → Secrets → Actions
#   2. Streamlit Cloud → App settings → Secrets (TOML format, see below)
#
# Streamlit Cloud secrets format (paste under App settings → Secrets):
#   SUPABASE_URL = "https://<ref>.supabase.co"
#   SUPABASE_ANON_KEY = "eyJ..."
#
# db.py backend selection logic:
#   GHOSTVENDOR_LOCAL_DEV=1 set  → SQLite always (even if SUPABASE_URL present)
#   GHOSTVENDOR_LOCAL_DEV unset + SUPABASE_URL set → Supabase
#   GHOSTVENDOR_LOCAL_DEV unset + SUPABASE_URL unset → SQLite
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
